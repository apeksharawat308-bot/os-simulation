{
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["backend/tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "terminal.integrated.env.windows": { "PYTHONPATH": "${workspaceFolder}\\backend" },
  "terminal.integrated.env.linux": { "PYTHONPATH": "${workspaceFolder}/backend" },
  "terminal.integrated.env.osx": { "PYTHONPATH": "${workspaceFolder}/backend" },
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true }
}
